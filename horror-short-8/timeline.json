   "end": 19.691,
   "text": "もういいよ"
  },
  {
   "id": "l3",
   "kind": "nar",
   "start": 20.191,
   "end": 24.639,
   "text": "1人、2人、3人。\n全員、見つけました。"
  },
  {
   "id": "l4",
   "kind": "nar",
   "start": 25.139,
   "end": 28.35,
   "text": "日が暮れてきたので\n帰ろうとした、そのとき。"
  },
  {
   "id": "extra",
   "kind": "clip",
   "start": 29.05,
   "end": 30.469,
   "text": "[「もういいよ」]"
  },
  {
   "id": "l5",
   "kind": "nar",
   "start": 31.169,
   "end": 34.358,
   "text": "神社の奥から、[もう一度]\n声がしたんです。"
  },
  {
   "id": "l6",
   "kind": "nar",
   "start": 34.758,
   "end": 36.966,
   "text": "私たちは、走って逃げました。"
  },
  {
   "id": "l7",
   "kind": "nar",
   "start": 37.666,
   "end": 41.666,
   "text": "帰り道。夕日で長くのびた\nみんなの影。"
  },
  {
   "id": "l8",
   "kind": "nar",
   "start": 42.066,
   "end": 44.199,
   "text": "なんとなく、数えてみたんです。"
