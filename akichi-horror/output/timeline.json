 "cues": [
  {
   "a": 3.7,
   "b": 6.448,
   "text": "うちの近所に、\nずっと空き地がある。"
  },
  {
   "a": 7.398,
   "b": 14.396,
   "text": "看板には「売地」の文字。\nでも電話番号だけが\n黒く塗りつぶされている。"
  },
  {
   "a": 15.346,
   "b": 19.593,
   "text": "不思議なことに\n草が一本も生えていない。\n……真夏でも。"
  },
  {
   "a": 20.743,
   "b": 23.944,
   "text": "そして毎晩、午前2時。"
  },
  {
   "a": 24.594,
   "b": 27.796,
   "text": "空き地の真ん中に\n誰かが立っている。"
  },
  {
   "a": 29.246,
   "b": 34.57,
   "text": "近所の人に聞いてみた。\n「あの空き地、\n前は何があったんですか」"
  },
  {
   "a": 35.12,
   "b": 38.527,
   "text": "「空き地?\nそんなもの、どこにあるの?」"
  },
  {
   "a": 39.877,
   "b": 45.901,
   "text": "昨日の夜、ついに近づいてみた。\nその人影は……\n私と同じ服を着ていた。"
  },
  {
   "a": 47.051,
   "b": 52.494,
   "text": "振り返ると、私の部屋の窓から\n誰かが、こっちを見ていた。"
  },
  {
   "a": 54.844,
   "b": 59.49,
   "text": "今夜2時。\n窓の外は、見ないでください。"
  }
 ]
}