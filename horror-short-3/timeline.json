   "id": "hook",
   "kind": "nar",
   "start": 0.4,
   "end": 5.68,
   "text": "一人暮らしの私が、睡眠アプリで\n[寝ている間の音]を録音してみた結果。"
  },
  {
   "id": "open",
   "kind": "nar",
   "start": 6.18,
   "end": 10.489,
   "text": "朝、アプリを開くと\n録音が[3件]、残っていました。"
  },
  {
   "id": "r1",
   "kind": "nar",
   "start": 10.939,
   "end": 13.937,
   "text": "1件目。午前2時13分。\nいびき。"
  },
  {
   "id": "r2",
   "kind": "nar",
   "start": 17.837,
   "end": 20.429,
   "text": "2件目。3時7分。\n寝言。"
  },
  {
   "id": "c2",
   "kind": "clip",
   "start": 21.429,
   "end": 22.282,
   "text": "「……だれ?」"
  },
  {
   "id": "r3",
   "kind": "nar",
   "start": 23.282,
   "end": 26.397,
   "text": "3件目。3時33分。\n[話し声。]"
  },
  {
   "id": "c3",
   "kind": "clip",
   "start": 27.797,
   "end": 29.802,
   "text": "[「まだ、起きないで」]"
  },
  {
   "id": "notme",
   "kind": "nar",
   "start": 30.902,
   "end": 32.598,
   "text": "[私の声じゃ、ありません。]"
  },
  {
   "id": "stop",
   "kind": "nar",
   "start": 33.048,
   "end": 37.56,
   "text": "そして録音は、3時41分に\n[手動で]止められていました。"
  },
  {
   "id": "sleep",
   "kind": "nar",
   "start": 38.01,
   "end": 41.53,
   "text": "私は朝7時まで\n[一度も起きていない]のに。"
  },
  {
   "id": "again",
   "kind": "nar",
