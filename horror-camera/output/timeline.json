 "lines": [
  {
   "start": 0.6,
   "end": 3.0062,
   "text": "仕事中、スマホに通知が来ました。",
   "voice": "N"
  },
  {
   "start": 3.2562,
   "end": 5.3133,
   "text": "「人物を検知しました」",
   "voice": "Q"
  },
  {
   "start": 5.6133,
   "end": 7.4637,
   "text": "家には、猫しかいないのに。",
   "voice": "N"
  },
  {
   "start": 9.9137,
   "end": 12.2944,
   "text": "猫のために置いた、見守りカメラです。",
   "voice": "N"
  },
  {
   "start": 12.5944,
   "end": 14.6396,
   "text": "録画には、誰も映っていません。",
   "voice": "N"
  },
  {
   "start": 15.1396,
   "end": 19.202,
   "text": "なのにAIは、何もない場所を「人物」と判定していました。",
   "voice": "N"
  },
  {
   "start": 19.502,
   "end": 22.2156,
   "text": "猫だけが、じっと、そこを見上げている。",
   "voice": "N"
  },
  {
   "start": 23.6156,
   "end": 26.1035,
   "text": "通知は毎日、同じ時刻に来ました。",
   "voice": "N"
  },
  {
   "start": 26.5035,
   "end": 29.6709,
   "text": "そして、枠は日に日に、カメラへ近づいてくる。",
   "voice": "N"
  },
  {
   "start": 31.0209,
   "end": 34.2969,
   "text": "その夜。ベッドの中で、また通知が鳴りました。",
   "voice": "N"
  },
  {
   "start": 34.5969,
   "end": 36.5726,
   "text": "私がいるんだから、当然です。",
   "voice": "N"
  },
  {
   "start": 37.3726,
   "end": 38.7413,
   "text": "ライブ映像を開くと、",
   "voice": "N"
  },
  {
   "start": 39.0913,
   "end": 40.7205,
   "text": "枠が、二つありました。",
   "voice": "N"
  },
  {
   "start": 41.0205,
   "end": 42.6035,
   "text": "私の、すぐ横に。",
   "voice": "N"
  },
  {
   "start": 43.4535,
   "end": 45.2339,
   "text": "顔を上げても、誰もいない。",
   "voice": "N"
  },
  {
   "start": 46.1839,
   "end": 48.0366,
   "text": "もう一度、画面を見ると。",
   "voice": "N"
  },
  {
   "start": 48.9866,
   "end": 52.4733,
   "text": "枠は、私の、目の前にありました。",
   "voice": "H"
  },
  {
   "start": 53.5733,
   "end": 56.1829,
   "text": "ねえ、見えてないの?",
   "voice": "G"
  },
  {
   "start": 58.4929,
   "end": 62.7602,
   "text": "そのスマホのカメラにも、ちゃんと、映ってますよ。",
   "voice": "H"
  }
 ],
