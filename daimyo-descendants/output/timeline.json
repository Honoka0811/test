{
 "estimated": false,
 "scenes": [
  {
   "id": "hook",
   "start": 0.0,
   "end": 13.6,
   "lines": [
    {
     "start": 0.7,
     "end": 4.875,
     "text": "江戸時代のお殿様の子孫って、今なにをしているのかしら？"
    },
    {
     "start": 5.155,
     "end": 8.797,
     "text": "総理大臣に、大学教授、宇宙の研究者まで。"
    },
    {
     "start": 9.077,
     "end": 13.1,
     "text": "わたくし四国めたんが、意外すぎる「今」をご紹介しますわ！"
    }
   ]
  },
  {
   "id": "history",
   "start": 13.6,
   "end": 34.006,
   "lines": [
    {
     "start": 14.15,
     "end": 19.611,
     "text": "まずは前提から。明治維新で、大名家は「華族」という特別な身分になりました。"
    },
    {
     "start": 19.891,
     "end": 23.562,
     "text": "でも明治4年の廃藩置県で、領地は失います。"
    },
    {
     "start": 23.842,
     "end": 28.912,
     "text": "そして1947年、日本国憲法の施行で華族制度も廃止。"
    },
    {
     "start": 29.192,
     "end": 33.506,
     "text": "つまり今の子孫たちは、わたくしたちと同じ一般市民なのですわ。"
    }
   ]
  },
  {
   "id": "tokugawa",
   "start": 34.006,
   "end": 50.356,
   "lines": [
    {
     "start": 34.556,
     "end": 36.72,
     "text": "まずは将軍家、徳川宗家。"
    },
    {
     "start": 37.0,
     "end": 41.458,
     "text": "2023年、徳川家広さんが19代当主を継ぎました。"
    },
    {
     "start": 41.738,
     "end": 46.268,
     "text": "家広さんは政治・経済の評論家で、翻訳家でもあります。"
    },
    {
     "start": 46.548,
     "end": 49.856,
     "text": "アメリカで経済学を学んだ、国際派の当主ですわ。"
    }
   ]
  },
  {
   "id": "owari",
   "start": 50.356,
   "end": 65.645,
   "lines": [
    {
     "start": 50.906,
     "end": 53.1,
     "text": "御三家の筆頭、尾張徳川家。"
    },
    {
     "start": 53.38,
     "end": 58.236,
     "text": "22代当主の徳川義崇さんは、名古屋の徳川美術館の館長です。"
    },
    {
     "start": 58.516,
     "end": 61.711,
     "text": "国宝「源氏物語絵巻」などを所蔵する美術館。"
    },
    {
     "start": 61.991,
     "end": 65.145,
     "text": "ご先祖さまの宝を、今も守り続けているのですわ。"
    }
   ]
  },
  {
   "id": "shimazu",
   "start": 65.645,
   "end": 82.034,
   "lines": [
    {
     "start": 66.195,
     "end": 67.599,
     "text": "薩摩の島津家。"
    },
    {
     "start": 67.879,
     "end": 75.695,
     "text": "33代当主の島津忠裕さんは、名勝・仙巌園を運営する島津興業で経営に携わってきました。"
    },
    {
     "start": 75.975,
     "end": 77.734,
     "text": "神社の神職も務めています。"
    },
    {
     "start": 78.014,
     "end": 81.534,
     "text": "お殿様の一族が、観光の最前線に立っているのですわ。"
    }
   ]
  },
  {
   "id": "date",
   "start": 82.034,
   "end": 95.567,
   "lines": [
    {
     "start": 82.584,
     "end": 85.88,
     "text": "独眼竜・政宗で有名な、仙台の伊達家。"
    },
    {
     "start": 86.16,
     "end": 91.764,
     "text": "当主の伊達泰宗さんは、政宗の霊廟・瑞鳳殿の館長などを務めてきました。"
    },
    {
     "start": 92.044,
     "end": 95.067,
     "text": "政宗の歴史を、今の時代に伝えているのですわ。"
    }
   ]
  },
  {
   "id": "sanada",
   "start": 95.567,
   "end": 112.099,
   "lines": [
    {
     "start": 96.117,
     "end": 98.235,
     "text": "大河ドラマでもおなじみ、真田家。"
    },
    {
     "start": 98.515,
     "end": 104.939,
     "text": "松代真田家の当主・眞田幸俊さんは、なんと慶應義塾大学 理工学部の教授！"
    },
    {
     "start": 105.219,
     "end": 107.413,
     "text": "専門は、情報通信工学。"
    },
    {
     "start": 107.693,
     "end": 111.599,
     "text": "戦国の知将の家系が、今は通信の研究者なのですわ。"
    }
   ]
  },
  {
   "id": "uesugi",
   "start": 112.099,
   "end": 128.468,
   "lines": [
    {
     "start": 112.649,
     "end": 117.692,
     "text": "上杉謙信、そして名君・上杉鷹山の家、米沢の上杉家。"
    },
    {
     "start": 117.972,
     "end": 121.23,
     "text": "当主の上杉邦憲さんは、宇宙工学者。"
    },
    {
     "start": 121.51,
     "end": 124.796,
     "text": "JAXA宇宙科学研究所の名誉教授です。"
    },
    {
     "start": 125.076,
     "end": 127.968,
     "text": "お殿様の子孫が、宇宙を目指していたのですわ！"
    }
   ]
  },
  {
   "id": "yoshinobu",
   "start": 128.468,
   "end": 145.21,
   "lines": [
    {
     "start": 129.018,
     "end": 131.174,
     "text": "最後の将軍、徳川慶喜。"
    },
    {
     "start": 131.454,
     "end": 137.383,
     "text": "ひ孫の徳川慶朝さんは、広告制作会社のカメラマンを経て独立した写真家でした。"
    },
    {
     "start": 137.663,
     "end": 142.23,
     "text": "さらに、自ら焙煎に関わった「徳川将軍珈琲」でも知られています。"
    },
    {
     "start": 142.51,
     "end": 144.71,
     "text": "2017年に亡くなりました。"
    }
   ]
  },
  {
   "id": "arima",
   "start": 145.21,
   "end": 159.614,
   "lines": [
    {
     "start": 145.76,
     "end": 148.807,
     "text": "ここで番外編。年末の競馬「有馬記念」。"
    },
    {
     "start": 149.087,
     "end": 154.874,
     "text": "じつはこの名前、久留米藩主だった有馬家の当主・有馬頼寧さんにちなんでいるのですわ。"
    },
    {
     "start": 155.154,
     "end": 159.114,
     "text": "日本中央競馬会の理事長として、このレースを創設したのです。"
    }
   ]
  },
  {
   "id": "hosokawa",
   "start": 159.614,
   "end": 182.133,
   "lines": [
    {
     "start": 160.164,
     "end": 163.149,
     "text": "そして最後は、肥後熊本藩の細川家。"
    },
    {
     "start": 163.429,
     "end": 172.418,
     "text": "18代当主の細川護熙さんは、熊本県知事を経て、1993年に第79代内閣総理大臣に！"
    },
    {
     "start": 172.698,
     "end": 177.545,
     "text": "政界を引退したあとは、湯河原の工房で陶芸家として活動しています。"
    },
    {
     "start": 177.825,
     "end": 181.633,
     "text": "お殿様の子孫が、本当に「国のトップ」になっていたのですわ。"
    }
   ]
  },
  {
   "id": "outro",
   "start": 182.133,
   "end": 198.391,
   "lines": [
    {
     "start": 182.683,
     "end": 186.924,
     "text": "ご先祖さまの歴史を守る人もいれば、まったく別の道で活躍する人も。"
    },
    {
     "start": 187.204,
     "end": 190.248,
     "text": "あなたの街の大名家は、今どうしているかしら？"
    },
    {
     "start": 190.528,
     "end": 194.891,
     "text": "コメントで教えてくださいね。チャンネル登録もよろしくお願いしますわ！"
    }
   ]
  }
 ],
 "total": 198.391
}