 "lines": [
  {
   "start": 0.3,
   "end": 4.0492,
   "text": "毎晩、午前二時になると、壁を叩く音がするんです。",
   "voice": "N"
  },
  {
   "start": 8.2992,
   "end": 9.7634,
   "text": "きっちり、三回。",
   "voice": "N"
  },
  {
   "start": 10.2634,
   "end": 14.6621,
   "text": "隣の人だと思って管理人さんに苦情を言うと、こう言われました。",
   "voice": "N"
  },
  {
   "start": 15.2621,
   "end": 17.7938,
   "text": "「あなたの部屋、角部屋ですよね」",
   "voice": "Q"
  },
  {
   "start": 18.2438,
   "end": 20.5615,
   "text": "「その壁の向こうは、外ですよ」",
   "voice": "Q"
  },
  {
   "start": 22.1115,
   "end": 25.8536,
   "text": "四階の外壁には、足場も、ベランダも、ありません。",
   "voice": "N"
  },
  {
   "start": 29.1036,
   "end": 31.9024,
   "text": "次の夜。ノックは、窓から聞こえました。",
   "voice": "N"
  },
  {
   "start": 34.7024,
   "end": 36.9811,
   "text": "その次の夜は、玄関のドアから。",
   "voice": "N"
  },
  {
   "start": 39.2811,
   "end": 41.8386,
   "text": "少しずつ、近づいてきてる。",
   "voice": "H"
  },
  {
   "start": 42.9886,
   "end": 44.1561,
   "text": "そして、今夜。",
   "voice": "N"
  },
  {
   "start": 45.6061,
   "end": 48.0305,
   "text": "二時を過ぎても、ノックが、聞こえない。",
   "voice": "N"
  },
  {
   "start": 48.4805,
   "end": 50.7479,
   "text": "ほっとして、ふと、気づきました。",
   "voice": "N"
  },
  {
   "start": 51.5479,
   "end": 55.474,
   "text": "ノックって、「入っていいか」たずねるためのもの、ですよね。",
   "voice": "N"
  },
  {
   "start": 56.024,
   "end": 58.4659,
   "text": "じゃあ、もう、ノックをしないのは……",
   "voice": "N"
  },
  {
   "start": 59.7159,
   "end": 62.6325,
   "text": "もう、入ったから",
   "voice": "G"
  },
  {
   "start": 64.9625,
   "end": 67.2909,
   "text": "次は、あなたの部屋かも。",
   "voice": "H"
  }
 ],
