 "lines": [
  {
   "start": 0.5,
   "end": 2.747,
   "text": "「もういいかい」",
   "voice": "K"
  },
  {
   "start": 3.047,
   "end": 6.6405,
   "text": "おばあちゃんの家には、絶対に言っちゃいけない言葉がありました。",
   "voice": "N"
  },
  {
   "start": 9.1905,
   "end": 14.0362,
   "text": "子どもの頃、夏休みのたびに、知らない女の子と、かくれんぼをしました。",
   "voice": "N"
  },
  {
   "start": 14.3862,
   "end": 20.813,
   "text": "「その子が鬼のときは、何度聞かれても『まあだだよ』と答えなさい」",
   "voice": "Q"
  },
  {
   "start": 21.113,
   "end": 23.9644,
   "text": "「もういいよ」と言ったら、本当に見つかってしまうから。",
   "voice": "N"
  },
  {
   "start": 24.8144,
   "end": 29.065,
   "text": "それから二十年。おばあちゃんのお葬式で、あの家に帰りました。",
   "voice": "N"
  },
  {
   "start": 29.915,
   "end": 32.0455,
   "text": "遺品の中に、日記がありました。",
   "voice": "N"
  },
  {
   "start": 32.4455,
   "end": 39.5203,
   "text": "「昭和三十一年、夏。妹が押入れに隠れたまま、見つからなかった」",
   "voice": "QD"
  },
  {
   "start": 39.8203,
   "end": 44.0337,
   "text": "「見つけたとき、あの子は、もう冷たくなっていた」",
   "voice": "QD"
  },
  {
   "start": 46.3837,
   "end": 51.173,
   "text": "「私が死んだら、あの子は、次の相手を探しに行く」",
   "voice": "QD"
  },
  {
   "start": 53.023,
   "end": 56.3497,
   "text": "お葬式の夜。押入れの中から、声がしたんです。",
   "voice": "N"
  },
  {
   "start": 56.8497,
   "end": 59.0967,
   "text": "「もういいかい」",
   "voice": "K2"
  },
  {
   "start": 59.5467,
   "end": 61.1216,
   "text": "「まあだだよ」",
   "voice": "HM"
  },
  {
   "start": 63.4716,
   "end": 67.6445,
   "text": "答えるたびに、声は近づいてきました。押入れから、廊下へ。",
   "voice": "N"
  },
  {
   "start": 67.9445,
   "end": 69.7659,
   "text": "廊下から、障子の向こうへ。",
   "voice": "N"
  },
  {
   "start": 72.8659,
   "end": 74.2956,
   "text": "そして、午前三時。",
   "voice": "N"
  },
  {
   "start": 74.7956,
   "end": 77.0425,
   "text": "「もういいかい」",
   "voice": "K3"
  },
  {
   "start": 78.2425,
   "end": 79.7816,
   "text": "もう、限界でした。",
   "voice": "N"
  },
  {
   "start": 80.2316,
   "end": 84.0544,
   "text": "「もう、いいよ……やめて……」",
   "voice": "MY"
  },
  {
   "start": 84.7544,
   "end": 86.7924,
   "text": "言ってしまってから、気づいたんです。",
   "voice": "N"
  },
  {
   "start": 87.9424,
   "end": 89.474,
   "text": "みいつけた",
   "voice": "G"
  },
  {
   "start": 91.784,
   "end": 94.4204,
   "text": "あなたなら、なんて答えますか?",
   "voice": "H"
  },
  {
   "start": 94.9204,
   "end": 97.1674,
   "text": "「もういいかい」",
   "voice": "K3"
  }
 ],
