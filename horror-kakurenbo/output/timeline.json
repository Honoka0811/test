 "lines": [
  {
   "start": 0.5,
   "end": 2.747,
   "text": "「もういいかい」",
   "voice": "K"
  },
  {
   "start": 3.047,
   "end": 6.6405,
   "text": "おばあちゃんの家には、絶対に言っちゃいけない言葉がありました。",
   "voice": "N"
  },
  {
   "start": 9.1905,
   "end": 14.0362,
   "text": "子どもの頃、夏休みのたびに、知らない女の子と、かくれんぼをしました。",
   "voice": "N"
  },
  {
   "start": 14.3862,
   "end": 20.813,
   "text": "「その子が鬼のときは、何度聞かれても『まあだだよ』と答えなさい」",
   "voice": "Q"
  },
  {
   "start": 21.113,
   "end": 23.9644,
   "text": "「もういいよ」と言ったら、本当に見つかってしまうから。",
   "voice": "N"
  },
  {
   "start": 24.8144,
   "end": 29.065,
   "text": "それから二十年。おばあちゃんのお葬式で、あの家に帰りました。",
   "voice": "N"
  },
  {
   "start": 29.815,
   "end": 32.7569,
   "text": "その夜。押入れの中から、声がしたんです。",
   "voice": "N"
  },
  {
   "start": 33.2569,
   "end": 35.5038,
   "text": "「もういいかい」",
   "voice": "K2"
  },
  {
   "start": 35.9538,
   "end": 37.5287,
   "text": "「まあだだよ」",
   "voice": "HM"
  },
  {
   "start": 38.2287,
   "end": 42.4982,
   "text": "声は、毎晩、近づいてきました。押入れから、廊下へ。",
   "voice": "N"
  },
  {
   "start": 42.7982,
   "end": 44.6196,
   "text": "廊下から、障子の向こうへ。",
   "voice": "N"
  },
  {
   "start": 45.3696,
   "end": 46.5372,
   "text": "そして、今夜。",
   "voice": "N"
  },
  {
   "start": 47.0372,
   "end": 49.2841,
   "text": "「もういいかい」",
   "voice": "K3"
  },
  {
   "start": 50.4841,
   "end": 52.3692,
   "text": "「まあだだよ」と言いかけたとき。",
   "voice": "N"
  },
  {
   "start": 52.7692,
   "end": 54.6501,
   "text": "「もういいよ」",
   "voice": "M"
  },
  {
   "start": 55.0001,
   "end": 58.1064,
   "text": "私の声が、私の後ろで、答えたんです。",
   "voice": "N"
  },
  {
   "start": 59.2064,
   "end": 60.738,
   "text": "みいつけた",
   "voice": "G"
  },
  {
   "start": 63.048,
   "end": 65.6844,
   "text": "あなたなら、なんて答えますか?",
   "voice": "H"
  },
  {
   "start": 66.1844,
   "end": 68.4314,
   "text": "「もういいかい」",
   "voice": "K3"
  }
 ],
