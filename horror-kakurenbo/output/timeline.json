 "lines": [
  {
   "start": 0.5,
   "end": 2.747,
   "text": "「もういいかい」",
   "voice": "K"
  },
  {
   "start": 3.047,
   "end": 6.6405,
   "text": "おばあちゃんの家には、絶対に言っちゃいけない言葉がありました。",
   "voice": "N"
  },
  {
   "start": 9.1905,
   "end": 14.0362,
   "text": "子どもの頃、夏休みのたびに、知らない女の子と、かくれんぼをしました。",
   "voice": "N"
  },
  {
   "start": 14.3862,
   "end": 20.813,
   "text": "「その子が鬼のときは、何度聞かれても『まあだだよ』と答えなさい」",
   "voice": "Q"
  },
  {
   "start": 21.113,
   "end": 23.9644,
   "text": "「もういいよ」と言ったら、本当に見つかってしまうから。",
   "voice": "N"
  },
  {
   "start": 24.8144,
   "end": 29.065,
   "text": "それから二十年。おばあちゃんのお葬式で、あの家に帰りました。",
   "voice": "N"
  },
  {
   "start": 29.915,
   "end": 32.0454,
   "text": "遺品の中に、日記がありました。",
   "voice": "N"
  },
  {
   "start": 32.4454,
   "end": 39.5203,
   "text": "「昭和三十一年、夏。妹が押入れに隠れたまま、見つからなかった」",
   "voice": "QD"
  },
  {
   "start": 39.8203,
   "end": 44.0336,
   "text": "「見つけたとき、あの子は、もう冷たくなっていた」",
   "voice": "QD"
  },
  {
   "start": 46.3836,
   "end": 51.173,
   "text": "「私が死んだら、あの子は、次の相手を探しに行く」",
   "voice": "QD"
  },
  {
   "start": 52.023,
   "end": 54.9648,
   "text": "その夜。押入れの中から、声がしたんです。",
   "voice": "N"
  },
  {
   "start": 55.4648,
   "end": 57.7118,
   "text": "「もういいかい」",
   "voice": "K2"
  },
  {
   "start": 58.1618,
   "end": 59.7367,
   "text": "「まあだだよ」",
   "voice": "HM"
  },
  {
   "start": 60.4367,
   "end": 64.7062,
   "text": "声は、毎晩、近づいてきました。押入れから、廊下へ。",
   "voice": "N"
  },
  {
   "start": 65.0062,
   "end": 66.8276,
   "text": "廊下から、障子の向こうへ。",
   "voice": "N"
  },
  {
   "start": 67.5776,
   "end": 68.7451,
   "text": "そして、今夜。",
   "voice": "N"
  },
  {
   "start": 69.2451,
   "end": 71.4921,
   "text": "「もういいかい」",
   "voice": "K3"
  },
  {
   "start": 72.6921,
   "end": 74.5772,
   "text": "「まあだだよ」と言いかけたとき。",
   "voice": "N"
  },
  {
   "start": 74.9772,
   "end": 76.8581,
   "text": "「もういいよ」",
   "voice": "M"
  },
  {
   "start": 77.2081,
   "end": 80.3144,
   "text": "私の声が、私の後ろで、答えたんです。",
   "voice": "N"
  },
  {
   "start": 81.4144,
   "end": 82.9459,
   "text": "みいつけた",
   "voice": "G"
  },
  {
   "start": 85.2559,
   "end": 87.8924,
   "text": "あなたなら、なんて答えますか?",
   "voice": "H"
  },
  {
   "start": 88.3924,
   "end": 90.6394,
   "text": "「もういいかい」",
   "voice": "K3"
  }
 ],
