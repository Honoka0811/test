{
 "duration": 50.7,
 "lines": [
  {
   "id": "hook",
   "kind": "nar",
   "start": 0.4,
   "end": 6.459,
   "text": "スマートロックの履歴を見たら\n[毎晩、午前3時に、内側から]\n鍵が開けられていた話。"
  },
  {
   "id": "l1",
   "kind": "nar",
   "start": 6.959,
   "end": 12.484,
   "text": "一人暮らしの私は、ある朝\n玄関のスマートロックの履歴を開きました。"
  },
  {
   "id": "l3",
   "kind": "nar",
   "start": 12.934,
   "end": 16.923,
   "text": "午前3時14分。\n[手動で解錠(室内側)。]"
  },
  {
   "id": "l4",
   "kind": "nar",
   "start": 17.373,
   "end": 20.019,
   "text": "ドアが開いて、1分後に閉まって。"
  },
  {
   "id": "l5",
   "kind": "nar",
   "start": 20.369,
   "end": 22.577,
   "text": "また、[室内側から施錠。]"
  },
  {
   "id": "l6",
   "kind": "nar",
   "start": 23.077,
   "end": 25.477,
   "text": "私は、その時間、寝ていました。"
  },
  {
   "id": "l7",
   "kind": "nar",
   "start": 25.977,
   "end": 30.67,
   "text": "さかのぼると、1週間\n[毎晩、同じ記録]が残っていました。"
  },
  {
   "id": "l8",
   "kind": "nar",
   "start": 31.17,
   "end": 34.541,
   "text": "内側のつまみは\n[中にいる人にしか回せません。]"
  },
  {
   "id": "l9",
   "kind": "nar",
   "start": 34.941,
   "end": 37.213,
   "text": "そして、閉めたのも、内側から。"
  },
  {
   "id": "l10",
   "kind": "nar",
   "start": 37.613,
   "end": 40.471,
   "text": "つまり、開けた誰かは\n[まだ、中にいる。]"
  },
  {
   "id": "l11",
   "kind": "nar",
   "start": 41.371,
   "end": 45.446,
   "text": "そして今夜。3時14分。\n[通知が、来ました。]"
  },
  {
   "id": "now",
   "kind": "clip",
   "start": 47.346,
   "end": 48.402,
   "text": "[「あけたよ」]"
  }
 ]
}