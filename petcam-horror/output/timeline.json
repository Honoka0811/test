 "cues": [
  {
   "a": 0.2,
   "b": 5.563,
   "text": "留守中のペットカメラ\nうちのコタが\n誰もいない所に尻尾を振ってる",
   "kind": "me"
  },
  {
   "a": 6.063,
   "b": 10.1,
   "text": "次の日も、その次の日も\n同じ場所で\nお手までしてる",
   "kind": "me"
  },
  {
   "a": 10.7,
   "b": 14.87,
   "text": "そこは去年亡くなった\nおばあちゃんが\nいつも座ってた場所",
   "kind": "me"
  },
  {
   "a": 14.97,
   "b": 17.919,
   "text": "会いに来てくれてるのかなって\nちょっと泣いた",
   "kind": "me"
  },
  {
   "a": 18.619,
   "b": 21.749,
   "text": "友達に録画を見せたら\n急に真顔になった",
   "kind": "me"
  },
  {
   "a": 22.049,
   "b": 25.17,
   "text": "「ねえ……テレビ、見て」",
   "kind": "friend"
  },
  {
   "a": 29.27,
   "b": 32.48,
   "text": "テレビの画面に\n知らない男が映ってた",
   "kind": "me"
  },
  {
   "a": 32.68,
   "b": 34.461,
   "text": "手には、コタのおやつ",
   "kind": "me"
  },
  {
   "a": 34.761,
   "b": 38.36,
   "text": "毎日来てたのは\nコタを吠えなくするためだった",
   "kind": "me"
  },
  {
   "a": 40.06,
   "b": 42.727,
   "text": "今夜、リビングで\n物音がした",
   "kind": "me"
  },
  {
   "a": 43.027,
   "b": 44.769,
   "text": "コタは、吠えなかった",
   "kind": "me"
  }
 ]
