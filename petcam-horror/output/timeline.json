 "cues": [
  {
   "a": 0.2,
   "b": 5.563,
   "text": "留守中のペットカメラ\nうちのコタが\n誰もいない所に尻尾を振ってる",
   "kind": "me"
  },
  {
   "a": 6.063,
   "b": 10.1,
   "text": "次の日も、その次の日も\n同じ場所で\nお手までしてる",
   "kind": "me"
  },
  {
   "a": 10.7,
   "b": 14.87,
   "text": "そこは去年亡くなった\nおばあちゃんが\nいつも座ってた場所",
   "kind": "me"
  },
  {
   "a": 14.97,
   "b": 17.919,
   "text": "会いに来てくれてるのかなって\nちょっと泣いた",
   "kind": "me"
  },
  {
   "a": 18.719,
   "b": 21.238,
   "text": "夜中、友達から\nメッセージが来た",
   "kind": "me"
  },
  {
   "a": 21.538,
   "b": 26.867,
   "text": "「ねえ、送ってくれた動画……\nテレビ、見て」",
   "kind": "friend"
  },
  {
   "a": 30.968,
   "b": 34.177,
   "text": "テレビの画面に\n知らない男が映ってた",
   "kind": "me"
  },
  {
   "a": 34.377,
   "b": 36.159,
   "text": "手には、コタのおやつ",
   "kind": "me"
  },
  {
   "a": 36.459,
   "b": 40.058,
   "text": "毎日来てたのは\nコタを吠えなくするためだった",
   "kind": "me"
  },
  {
   "a": 41.558,
   "b": 43.642,
   "text": "その時、通知が来た",
   "kind": "me"
  },
  {
   "a": 44.742,
   "b": 46.375,
   "text": "コタは、吠えてない",
   "kind": "me"
  }
 ]
