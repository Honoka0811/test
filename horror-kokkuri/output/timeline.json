 "lines": [
  {
   "start": 0.35,
   "end": 3.4123,
   "text": "うちの学校の七不思議には、七つ目がありません。",
   "voice": "N"
  },
  {
   "start": 5.8623,
   "end": 7.9212,
   "text": "六つまでは、誰でも知っています。",
   "voice": "N"
  },
  {
   "start": 8.2713,
   "end": 11.2406,
   "text": "でも、七つ目を知った人は、いなくなるんです。",
   "voice": "N"
  },
  {
   "start": 12.0406,
   "end": 14.704,
   "text": "だから放課後、コックリさんに聞いてみたんです。",
   "voice": "N"
  },
  {
   "start": 15.054,
   "end": 20.2282,
   "text": "「コックリさん、コックリさん。七つ目を教えてください」",
   "voice": "C"
  },
  {
   "start": 20.5783,
   "end": 23.6483,
   "text": "十円玉が、ゆっくり、動きはじめました。",
   "voice": "N"
  },
  {
   "start": 28.9483,
   "end": 32.0395,
   "text": "教室の戸を、誰かが、三回叩いたんです。",
   "voice": "N"
  },
  {
   "start": 32.6395,
   "end": 36.1128,
   "text": "慌てて「お帰りください」と言うと、十円玉は……",
   "voice": "N"
  },
  {
   "start": 38.8128,
   "end": 42.7347,
   "text": "その夜から、私の部屋の窓が、毎晩、叩かれます。",
   "voice": "N"
  },
  {
   "start": 45.4847,
   "end": 47.7612,
   "text": "そして今夜、四時四十四分。",
   "voice": "N"
  },
  {
   "start": 49.0112,
   "end": 50.3411,
   "text": "ノックが、ありません。",
   "voice": "N"
  },
  {
   "start": 51.1411,
   "end": 55.0671,
   "text": "ノックって、「入っていいか」たずねるためのもの、ですよね。",
   "voice": "N"
  },
  {
   "start": 55.5671,
   "end": 59.2067,
   "text": "でも、あの日、私たちは最初に、こう言ったんです。",
   "voice": "N"
  },
  {
   "start": 59.6067,
   "end": 63.7027,
   "text": "「コックリさん、コックリさん、おいでください」",
   "voice": "CF"
  },
  {
   "start": 65.6027,
   "end": 67.6789,
   "text": "だから、来たよ",
   "voice": "G"
  },
  {
   "start": 70.0089,
   "end": 72.5705,
   "text": "七つ目、知ってしまいましたね。",
   "voice": "H"
  }
 ],
