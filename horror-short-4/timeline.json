 "lines": [
  {
   "id": "hook",
   "kind": "nar",
   "start": 0.4,
   "end": 5.787,
   "text": "位置情報アプリで、親友のアイコンが\n[深夜に、私の家へ向かってきた]話。"
  },
  {
   "id": "l1",
   "kind": "nar",
   "start": 6.287,
   "end": 10.372,
   "text": "深夜1時。親友のミキのアイコンが\n動き出しました。"
  },
  {
   "id": "l2",
   "kind": "nar",
   "start": 10.772,
   "end": 13.471,
   "text": "まっすぐ、[私の家]に向かってきます。"
  },
  {
   "id": "l3",
   "kind": "nar",
   "start": 13.921,
   "end": 16.353,
   "text": "メッセージを送っても\n既読がつきません。"
  },
  {
   "id": "l4",
   "kind": "nar",
   "start": 16.803,
   "end": 18.979,
   "text": "あと300メートル。\n[100メートル。]"
  },
  {
   "id": "l5",
   "kind": "nar",
   "start": 19.379,
   "end": 21.064,
   "text": "家の前で、止まりました。"
  },
  {
   "id": "l6",
   "kind": "nar",
   "start": 21.564,
   "end": 23.847,
   "text": "でも、インターホンは\n[鳴りません。]"
  },
  {
   "id": "l7",
   "kind": "nar",
   "start": 24.847,
   "end": 28.335,
   "text": "アイコンは、そのまま\n[家の中に入ってきました。]"
  },
  {
   "id": "l8",
   "kind": "nar",
   "start": 28.735,
   "end": 30.185,
   "text": "距離、[0メートル。]"
  },
  {
   "id": "l9",
   "kind": "nar",
   "start": 31.485,
   "end": 34.248,
   "text": "そのとき、知らない番号から電話が。"
  },
  {
   "id": "call",
   "kind": "clip",
   "start": 34.748,
   "end": 39.847,
   "text": "「もしもし、ミキだけど。ごめん\n昨日、[スマホなくしちゃって]」"
  },
  {
   "id": "l11",
   "kind": "nar",
   "start": 40.647,
   "end": 43.857,
   "text": "じゃあ、いま\n[このスマホを持っているのは……]"
  },
  {
   "id": "l12",
   "kind": "nar",
   "start": 44.357,
   "end": 47.44,
   "text": "アイコンは、[私のベッドの下]を\n指していました。"
  },
  {
   "id": "now",
   "kind": "clip",
   "start": 48.94,
   "end": 49.868,
   "text": "[「みつけた」]"
  }
 ]
}