 "duration": 55.1,
 "lines": [
  {
   "id": "hook",
   "kind": "nar",
   "start": 0.4,
   "end": 5.787,
   "text": "位置情報アプリで、親友のアイコンが\n[深夜に、私の家へ向かってきた]話。"
  },
  {
   "id": "l1",
   "kind": "nar",
   "start": 6.287,
   "end": 10.372,
   "text": "深夜1時。親友のミキのアイコンが\n動き出しました。"
  },
  {
   "id": "l2",
   "kind": "nar",
   "start": 10.772,
   "end": 13.471,
   "text": "まっすぐ、[私の家]に向かってきます。"
  },
  {
   "id": "l3",
   "kind": "nar",
   "start": 13.921,
   "end": 16.353,
   "text": "メッセージを送っても\n既読がつきません。"
  },
  {
   "id": "l4",
   "kind": "nar",
   "start": 16.803,
   "end": 18.979,
   "text": "あと300メートル。\n[100メートル。]"
  },
  {
   "id": "l5",
   "kind": "nar",
   "start": 19.379,
   "end": 21.064,
   "text": "家の前で、止まりました。"
  },
  {
   "id": "l6",
   "kind": "nar",
   "start": 21.564,
   "end": 23.847,
   "text": "でも、インターホンは\n[鳴りません。]"
  },
  {
   "id": "l7",
   "kind": "nar",
   "start": 24.847,
   "end": 28.463,
   "text": "そして、アイコンは\n[私のアイコンと重なりました。]"
  },
  {
   "id": "l8",
   "kind": "nar",
   "start": 28.863,
   "end": 30.473,
   "text": "表示は、[「一緒にいます」。]"
  },
  {
   "id": "l9",
   "kind": "nar",
   "start": 31.773,
   "end": 34.536,
   "text": "そのとき、知らない番号から電話が。"
  },
  {
   "id": "call",
   "kind": "clip",
   "start": 35.036,
   "end": 41.98,
   "text": "「ミキだけど。お母さんのスマホから。\n昨日、[スマホなくしちゃって]」"
  },
  {
   "id": "call2",
   "kind": "clip",
   "start": 42.43,
   "end": 45.15,
   "text": "「いまから、[音を鳴らしてみるね]」"
  },
  {
   "id": "l12",
   "kind": "nar",
   "start": 47.05,
   "end": 50.271,
   "text": "音は、[私のベッドの下]から\n鳴りました。"
  },
  {
   "id": "now",
   "kind": "clip",
   "start": 51.871,
   "end": 52.799,
   "text": "[「みつけた」]"
  }
 ]
}